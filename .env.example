# ============================================================
# habRAG 密钥模板
# ============================================================
# 用法：把这个文件复制为 .env，然后填入自己的密钥。
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# ★ .env 已被 .gitignore 排除，不会进版本库。
# ★ 千万不要把真实密钥写进这个文件（它会被提交）。
# ============================================================

# ---- DeepSeek（主模型：查询改写 A9、回答生成、引用核对）----
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---- 智谱 GLM（light 模式的排版修正 / 核对，免费模型）----
# 申请：https://open.bigmodel.cn/
GLM_API_KEY=

# ---- SiliconFlow（bge-m3 向量嵌入 + bge-reranker-v2-m3 精排）----
# 申请：https://siliconflow.cn/
SILICONFLOW_API_KEY=

# ---- Zilliz Cloud（向量库）----
# 控制台「组织设置 → API Keys」新建；也可填 用户名:密码
# 注意：中国区 Serverless 目前只能在阿里云华东1（杭州）
ZILLIZ_TOKEN=

# ---- 以下为非密钥配置，可按需覆盖（留空则用 config.py 里的默认值）----
# HABRAG_BACKEND=zilliz
# ZILLIZ_URI=
# ZILLIZ_COLLECTION=habsburg
